# Copy to .env, or just run ./finalize_prod.sh which creates .env and fills every
# "replace-with-..." value with a strong random secret (it never overwrites real values).
ENVIRONMENT=production

POSTGRES_USER=starkeven
POSTGRES_PASSWORD=replace-with-generated-secret
POSTGRES_DB=starkeven
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=   # optional full override (postgresql+asyncpg://...); normally built from POSTGRES_*

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-generated-secret
ADMIN_API_KEY=replace-with-generated-secret
WEBHOOK_SECRET=replace-with-generated-secret

# Use your real domain here for automatic HTTPS (e.g. api.example.com); ":80" = plain HTTP.
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

# Domain used in the SMTP EHLO / MAIL FROM when verifying mailboxes. Use a domain you own
# whose PTR/SPF match your server, otherwise many mail servers will refuse the probe.
SMTP_HELO_DOMAIN=verify.example.com

# Optional free SMTP relay (Gmail App Password, Brevo 300/day, Postfix). Leave SMTP_HOST blank for direct-MX delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
