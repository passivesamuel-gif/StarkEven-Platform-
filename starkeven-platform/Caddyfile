# SITE_ADDRESS=:80 serves plain HTTP; set it to your domain (e.g. api.example.com) and Caddy
# obtains and renews a Let's Encrypt certificate automatically.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@api path /api/* /docs /docs/* /openapi.json /redoc /health
	handle @api {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
